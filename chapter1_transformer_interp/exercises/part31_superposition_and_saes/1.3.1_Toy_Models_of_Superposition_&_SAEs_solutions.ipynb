        "t.manual_seed(2)\n",
        "\n",
        "W = t.randn(2, 5)\n",
        "W_normed = W / W.norm(dim=0, keepdim=True)\n",
        "\n",
        "imshow(\n",
        "    W_normed.T @ W_normed,\n",
        "    title=\"Cosine similarities of each pair of 2D feature embeddings\",\n",
        "    width=600,\n",
        ")"
      ]
    },
    {
      "cell_type": "markdown",
