              "    const row_data = [{\"subplot_titles\": [\"Encoder weights (inst 0)\", \"Encoder weights (inst 1)\", \"Encoder weights (inst 2)\", \"Encoder weights (inst 3)\", \"Encoder weights (inst 4)\", \"Encoder weights (inst 5)\", \"Encoder weights (inst 6)\", \"Encoder weights (inst 7)\"], \"marker_size\": 5, \"line_width\": 2, \"batch_size\": 5, \"max_size\": 1.6515826940536498, \"tickmarks\": [-1, 0, 1]}, {\"subplot_titles\": [\"Decoder weights\", \"Decoder weights\", \"Decoder weights\", \"Decoder weights\", \"Decoder weights\", \"Decoder weights\", \"Decoder weights\", \"Decoder weights\"], \"marker_size\": 5, \"line_width\": 2, \"batch_size\": 5, \"max_size\": 1.6515826940536498, \"tickmarks\": [-1, 0, 1]}];\n",
              "\n",
              "    const n_timesteps = 201;\n",
