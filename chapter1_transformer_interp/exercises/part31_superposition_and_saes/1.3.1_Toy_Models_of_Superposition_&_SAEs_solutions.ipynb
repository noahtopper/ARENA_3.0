        "utils.plot_features_in_Nd(\n",
        "    model.W,\n",
        "    height=600,\n",
        "    width=1000,\n",
        "    title=f\"Neuron model: {cfg.n_features=}, {cfg.d_hidden=}, I<sub>i</sub> = 0.75<sup>i</sup>\",\n",
