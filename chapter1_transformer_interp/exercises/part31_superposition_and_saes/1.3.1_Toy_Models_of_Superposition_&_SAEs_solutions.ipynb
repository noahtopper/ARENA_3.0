        "LEARNING_RATE = 1e-3\n",
        "\n",
        "BATCH_SIZES = [3, 5, 6, 8, 10, 15, 30, 50, 100, 200, 500, 1000, 2000]\n",
        "\n",
        "N_FEATURES = 1000\n",
        "N_INSTANCES = 5\n",
        "N_HIDDEN = 2\n",
        "SPARSITY = 0.99\n",
        "FEATURE_PROBABILITY = 1 - SPARSITY"
